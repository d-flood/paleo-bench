{
  "name": "paleo-bench",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "node scripts/split-results-for-site.mjs && vite dev",
    "gen:site-data": "node scripts/split-results-for-site.mjs",
    "build": "node scripts/split-results-for-site.mjs && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-devtools-json": "^1.1.2"
  },
  "dependencies": {
    "diff": "^8.0.3",
    "phosphor-svelte": "^3.1.1",
    "triiiceratops": "^1.3.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
